<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/hiddenAppsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="HIDDEN APPS"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnHiddenManage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/cc_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:text="⚙ Manage / Unhide"
                android:textColor="#80D8FF"
                android:textSize="12sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/btnHiddenClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/cc_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <GridView
        android:id="@+id/hiddenAppsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="12dp"
        android:gravity="center"
        android:focusable="true"
        android:descendantFocusability="afterDescendants" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Click OK to Open or Unhide • ⚙ Manage to select multiple"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:layout_marginTop="12dp" />

</LinearLayout>
