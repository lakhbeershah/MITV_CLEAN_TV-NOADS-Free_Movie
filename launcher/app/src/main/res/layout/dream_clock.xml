<?xml version="1.0" encoding="utf-8"?>
<!-- Ambient Photo Screensaver: Full-screen continuous photo filmstrip with overlaid clock with seconds -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.PhotoSlider
        android:id="@+id/dreamPhotoSlider"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cinema scrim: darkens photo layer so the clock is always crystal clear -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="28dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="#FFFFFFFF"
            android:textSize="54sp"
            android:textStyle="bold"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:shadowColor="#D9000000"
            android:shadowRadius="14"
            android:shadowDy="3" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:format12Hour="@string/date_format_home"
            android:format24Hour="@string/date_format_home"
            android:textColor="#E6FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:shadowColor="#D9000000"
            android:shadowRadius="10"
            android:shadowDy="2" />
    </LinearLayout>
</FrameLayout>
