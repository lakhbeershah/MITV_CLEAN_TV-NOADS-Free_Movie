<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Primary Fullscreen WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="gone" />

    <!-- Fullscreen Video Container (Exo / WebChrome Custom View) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Living Room TV Speed Dial (Home Screen) -->
    <ScrollView
        android:id="@+id/speedDialView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <!-- TV Browser Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="CLEAN TV BROWSER"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/badgeShield"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🛡️ Ad &amp; Video Shield ON"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search / URL Bar -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="720dp"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_hud_pill"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/editSearchUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:hint="Search Google or enter web URL..."
                    android:imeOptions="actionSearch"
                    android:inputType="textUri|text"
                    android:maxLines="1"
                    android:nextFocusDown="@+id/cardHdMovie2"
                    android:nextFocusRight="@+id/btnGoSearch"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnGoSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@+id/cardYouTube"
                    android:nextFocusLeft="@+id/editSearchUrl"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Search ➔"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Cards: Pinned Streaming & Entertainment (HDMovie2, Stream Play, Game Links, YouTube) -->
            <TextView
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="PINNED TV HUBS &amp; ENTERTAINMENT"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- 1. HDMovie2 -->
                <LinearLayout
                    android:id="@+id/cardHdMovie2"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusRight="@+id/cardStreamPlay"
                    android:orientation="vertical">

                    <requestFocus />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍿"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="HDMovie2"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Stream Play (Movies, Series, Bollywood, Live TV) -->
                <LinearLayout
                    android:id="@+id/cardStreamPlay"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusLeft="@+id/cardHdMovie2"
                    android:nextFocusRight="@+id/cardGameLinks"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Stream Play"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Game Links (TV Games, Poki, Retro Arcade) -->
                <LinearLayout
                    android:id="@+id/cardGameLinks"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusLeft="@+id/cardStreamPlay"
                    android:nextFocusRight="@+id/cardYouTube"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Game Links"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. YouTube -->
                <LinearLayout
                    android:id="@+id/cardYouTube"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/btnGoSearch"
                    android:nextFocusLeft="@+id/cardGameLinks"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📺"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="YouTube"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TV Remote Shortcuts Hint Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_hud_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="💡 Remote Shortcuts: Hold OK = Quick Menu  •  Hold BACK = Toggle Mouse Cursor  •  Video: ▲/▼ Volume, ◀/▶ Seek"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Top Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressDrawable="@drawable/bg_hud_pill"
        android:visibility="gone" />

    <!-- On-Screen In-Video HUD (Volume & Seek Feedback) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hudIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/hudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Volume: 65%"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Context Radial Quick Menu (Hold OK) -->
    <LinearLayout
        android:id="@+id/radialMenuLayout"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_radial_menu"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ QUICK ACTIONS"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Row 1: Speed Dial & Reload Page -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnHome"
                android:nextFocusLeft="@+id/menuBtnHome"
                android:nextFocusRight="@+id/menuBtnReload"
                android:nextFocusDown="@+id/menuBtnDpadMode"
                android:text="🏠 Speed Dial"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnReload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnReload"
                android:nextFocusLeft="@+id/menuBtnHome"
                android:nextFocusRight="@+id/menuBtnReload"
                android:nextFocusDown="@+id/menuBtnUserAgent"
                android:text="🔄 Reload Page"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 2: Turn ON/OFF D-Pad Mode & Mobile/Desktop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnDpadMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnHome"
                android:nextFocusLeft="@+id/menuBtnDpadMode"
                android:nextFocusRight="@+id/menuBtnUserAgent"
                android:nextFocusDown="@+id/menuBtnZoomIn"
                android:text="🎮 Turn ON D-Pad"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnUserAgent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnReload"
                android:nextFocusLeft="@+id/menuBtnDpadMode"
                android:nextFocusRight="@+id/menuBtnUserAgent"
                android:nextFocusDown="@+id/menuBtnZoomOut"
                android:text="📱 Mobile (Smooth)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Zoom In, 100% Scale, Zoom Out -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnZoomIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnDpadMode"
                android:nextFocusLeft="@+id/menuBtnZoomIn"
                android:nextFocusRight="@+id/menuBtnZoomOut"
                android:nextFocusDown="@+id/menuBtnDarkMode"
                android:text="🔍 Zoom In (+)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textZoomScale"
                android:layout_width="74dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_hud_pill"
                android:focusable="false"
                android:gravity="center"
                android:text="125%"
                android:textColor="@color/accent_blue"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnZoomOut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnUserAgent"
                android:nextFocusLeft="@+id/menuBtnZoomIn"
                android:nextFocusRight="@+id/menuBtnZoomOut"
                android:nextFocusDown="@+id/menuBtnSettings"
                android:text="🔎 Zoom Out (-)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: Dark Mode & Settings / Clear RAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnDarkMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnZoomIn"
                android:nextFocusLeft="@+id/menuBtnDarkMode"
                android:nextFocusRight="@+id/menuBtnSettings"
                android:nextFocusDown="@+id/menuBtnDarkMode"
                android:text="🌙 Force Dark: OFF"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnZoomOut"
                android:nextFocusLeft="@+id/menuBtnDarkMode"
                android:nextFocusRight="@+id/menuBtnSettings"
                android:nextFocusDown="@+id/menuBtnSettings"
                android:text="🧹 Settings &amp; Clean"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Virtual D-Pad Mouse Cursor View Overlay -->
    <com.clean.browser.VirtualCursorView
        android:id="@+id/cursorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
