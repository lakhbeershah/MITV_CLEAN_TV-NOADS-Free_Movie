<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Primary Fullscreen WebView -->
    <com.clean.browser.CleanTvWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="gone" />

    <!-- Fullscreen Video Container (Exo / WebChrome Custom View) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Living Room TV Speed Dial (Home Screen) -->
    <ScrollView
        android:id="@+id/speedDialView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <!-- TV Browser Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="CLEAN TV BROWSER"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/badgeShield"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🛡️ Ad &amp; Video Shield ON"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search / URL Bar -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="720dp"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_hud_pill"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/editSearchUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:hint="Search Google or enter web URL..."
                    android:imeOptions="actionSearch"
                    android:inputType="textUri|text"
                    android:maxLines="1"
                    android:nextFocusDown="@+id/cardHdMovie2"
                    android:nextFocusRight="@+id/btnGoSearch"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnGoSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@+id/cardYouTube"
                    android:nextFocusLeft="@+id/editSearchUrl"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Search ➔"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Cards: Pinned Streaming & Entertainment (HDMovie2, Stream Play, Game Links, YouTube) -->
            <TextView
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="PINNED TV HUBS &amp; ENTERTAINMENT"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="760dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- 1. Last / Active Page -->
                <LinearLayout
                    android:id="@+id/cardLastActivePage"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusRight="@+id/cardHdMovie2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/txtLastPageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Active Page"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. HDMovie2 (Google Search Query) -->
                <LinearLayout
                    android:id="@+id/cardHdMovie2"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusLeft="@+id/cardLastActivePage"
                    android:nextFocusRight="@+id/cardStreamPlay"
                    android:orientation="vertical">

                    <requestFocus />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍿"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="HDMovie2"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Stream Play (Movies, Series, Bollywood, Live TV) -->
                <LinearLayout
                    android:id="@+id/cardStreamPlay"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusLeft="@+id/cardHdMovie2"
                    android:nextFocusRight="@+id/cardGameLinks"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Stream Play"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. Game Links (TV Games, Poki, Retro Arcade) -->
                <LinearLayout
                    android:id="@+id/cardGameLinks"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/editSearchUrl"
                    android:nextFocusLeft="@+id/cardStreamPlay"
                    android:nextFocusRight="@+id/cardYouTube"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Game Links"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. YouTube -->
                <LinearLayout
                    android:id="@+id/cardYouTube"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusUp="@+id/btnGoSearch"
                    android:nextFocusLeft="@+id/cardGameLinks"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📺"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="YouTube"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TV Remote Shortcuts Hint Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_hud_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="💡 Remote Shortcuts: Hold OK = Quick Menu  •  Hold BACK = Forward ➔ / Mouse Mode  •  Video: ▲/▼ Volume, ◀/▶ Seek"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Top Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressDrawable="@drawable/bg_hud_pill"
        android:visibility="gone" />

    <!-- On-Screen In-Video & Navigation HUD (Half-Sized Compact Pill) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hudIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/hudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:text="Volume: 65%"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Context Quick Actions Menu (Hold OK) -->
    <LinearLayout
        android:id="@+id/radialMenuLayout"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_radial_menu"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ QUICK ACTIONS"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Row 1: Speed Dial & Reload Page -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnHome"
                android:nextFocusLeft="@+id/menuBtnHome"
                android:nextFocusRight="@+id/menuBtnReload"
                android:nextFocusDown="@+id/menuBtnModeMouse"
                android:text="🏠 Speed Dial"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnReload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnReload"
                android:nextFocusLeft="@+id/menuBtnHome"
                android:nextFocusRight="@+id/menuBtnReload"
                android:nextFocusDown="@+id/menuBtnModeMovie"
                android:text="🔄 Reload Page"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 3 Explicit Control Modes (Mouse | D-Pad | Movie) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnModeMouse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnHome"
                android:nextFocusLeft="@+id/menuBtnModeMouse"
                android:nextFocusRight="@+id/menuBtnModeDpad"
                android:nextFocusDown="@+id/menuBtnZoomIn"
                android:text="🎯 Mouse"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnModeDpad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnHome"
                android:nextFocusLeft="@+id/menuBtnModeMouse"
                android:nextFocusRight="@+id/menuBtnModeMovie"
                android:nextFocusDown="@+id/menuBtnZoomIn"
                android:text="🎮 D-Pad"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnModeMovie"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnReload"
                android:nextFocusLeft="@+id/menuBtnModeDpad"
                android:nextFocusRight="@+id/menuBtnModeMovie"
                android:nextFocusDown="@+id/menuBtnZoomOut"
                android:text="🎬 Movie"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Zoom In, Scale %, Zoom Out -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnZoomIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnModeMouse"
                android:nextFocusLeft="@+id/menuBtnZoomIn"
                android:nextFocusRight="@+id/menuBtnZoomOut"
                android:nextFocusDown="@+id/menuBtnUserAgent"
                android:text="🔍 Zoom In (+)"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textZoomScale"
                android:layout_width="74dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_hud_pill"
                android:focusable="false"
                android:gravity="center"
                android:text="125%"
                android:textColor="@color/accent_blue"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnZoomOut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnModeMovie"
                android:nextFocusLeft="@+id/menuBtnZoomIn"
                android:nextFocusRight="@+id/menuBtnZoomOut"
                android:nextFocusDown="@+id/menuBtnDarkMode"
                android:text="🔎 Zoom Out (-)"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: User-Agent & Dark Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menuBtnUserAgent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnZoomIn"
                android:nextFocusLeft="@+id/menuBtnUserAgent"
                android:nextFocusRight="@+id/menuBtnDarkMode"
                android:nextFocusDown="@+id/menuBtnSettings"
                android:text="📱 Mobile (Smooth)"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBtnDarkMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/menuBtnZoomOut"
                android:nextFocusLeft="@+id/menuBtnUserAgent"
                android:nextFocusRight="@+id/menuBtnDarkMode"
                android:nextFocusDown="@+id/menuBtnSettings"
                android:text="🌙 Force Dark: OFF"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 5: Pointer & Browser Settings -->
        <TextView
            android:id="@+id/menuBtnSettings"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@+id/menuBtnUserAgent"
            android:nextFocusLeft="@+id/menuBtnSettings"
            android:nextFocusRight="@+id/menuBtnSettings"
            android:nextFocusDown="@+id/menuBtnSettings"
            android:text="⚙️ Settings (Pointer Speed, Accel &amp; Clean)"
            android:textColor="@color/menu_item_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- TV Bro-Style Pointer & Browser Settings Overlay -->
    <LinearLayout
        android:id="@+id/settingsMenuLayout"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_radial_menu"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ POINTER &amp; BROWSER SETTINGS"
            android:textColor="@color/accent_blue"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Pointer Speed Stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSpeedDown"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnSpeedDown"
                android:nextFocusLeft="@+id/btnSpeedDown"
                android:nextFocusRight="@+id/btnSpeedUp"
                android:nextFocusDown="@+id/btnAccelDown"
                android:text="−"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSettingSpeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:focusable="false"
                android:gravity="center"
                android:text="Pointer Speed: 4 / 10"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSpeedUp"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnSpeedUp"
                android:nextFocusLeft="@+id/btnSpeedDown"
                android:nextFocusRight="@+id/btnSpeedUp"
                android:nextFocusDown="@+id/btnAccelUp"
                android:text="+"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pointer Acceleration Stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAccelDown"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnSpeedDown"
                android:nextFocusLeft="@+id/btnAccelDown"
                android:nextFocusRight="@+id/btnAccelUp"
                android:nextFocusDown="@+id/btnScrollDown"
                android:text="−"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSettingAccel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:focusable="false"
                android:gravity="center"
                android:text="Acceleration: 4 / 10"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAccelUp"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnSpeedUp"
                android:nextFocusLeft="@+id/btnAccelDown"
                android:nextFocusRight="@+id/btnAccelUp"
                android:nextFocusDown="@+id/btnScrollUp"
                android:text="+"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scroll Speed Stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnScrollDown"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnAccelDown"
                android:nextFocusLeft="@+id/btnScrollDown"
                android:nextFocusRight="@+id/btnScrollUp"
                android:nextFocusDown="@+id/btnResetPointer"
                android:text="−"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSettingScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:focusable="false"
                android:gravity="center"
                android:text="Scroll Speed: 5 / 10"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScrollUp"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnAccelUp"
                android:nextFocusLeft="@+id/btnScrollDown"
                android:nextFocusRight="@+id/btnScrollUp"
                android:nextFocusDown="@+id/btnSettingsDone"
                android:text="+"
                android:textColor="@color/menu_item_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Actions: Reset, Clear RAM, Done -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResetPointer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnScrollDown"
                android:nextFocusLeft="@+id/btnResetPointer"
                android:nextFocusRight="@+id/btnClearCache"
                android:nextFocusDown="@+id/btnResetPointer"
                android:text="↺ Reset"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearCache"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnScrollDown"
                android:nextFocusLeft="@+id/btnResetPointer"
                android:nextFocusRight="@+id/btnSettingsDone"
                android:nextFocusDown="@+id/btnClearCache"
                android:text="🧹 Clear RAM"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettingsDone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@+id/btnScrollUp"
                android:nextFocusLeft="@+id/btnClearCache"
                android:nextFocusRight="@+id/btnSettingsDone"
                android:nextFocusDown="@+id/btnSettingsDone"
                android:text="✓ Done"
                android:textColor="@color/menu_item_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Virtual D-Pad Mouse Cursor View Overlay -->
    <com.clean.browser.VirtualCursorView
        android:id="@+id/cursorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
