<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Tech Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#091428"
                android:centerColor="#0A2540"
                android:endColor="#05101A" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#3300E5FF" />
        </shape>
    </item>
    <!-- Centered Glowing Vector Icon -->
    <item
        android:width="76dp"
        android:height="76dp"
        android:gravity="center"
        android:drawable="@drawable/ic_browser_logo" />
</layer-list>
