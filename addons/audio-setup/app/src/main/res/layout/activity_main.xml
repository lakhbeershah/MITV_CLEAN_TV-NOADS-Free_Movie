<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:clipToPadding="false"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_audio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="AUDIO SETUP"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_active_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_selector"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="ACTIVE: CRISP DIALOGUE"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="Sound Profiles (Click to apply)"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Presets Grid Container -->
        <GridLayout
            android:id="@+id/grid_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:orientation="horizontal" />

        <!-- Control Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play_sample"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/btn_selector"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="▶  Test Audio Sample"
                android:textColor="@drawable/btn_text_color"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_toggle_custom"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_selector"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🎛️  Custom Equalizer"
                android:textColor="@drawable/btn_text_color"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Custom Equalizer & Effects Container -->
        <LinearLayout
            android:id="@+id/layout_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_selector"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom 5-Band Equalizer (Use Remote Left/Right)"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 5 Sliders injected programmatically in MainActivity -->
            <LinearLayout
                android:id="@+id/layout_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- Toggles Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Master Sound Enhancements"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle_night"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_selector"
                    android:focusable="true"
                    android:text="Dialogue Boost: ON"
                    android:textColor="@drawable/btn_text_color"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_toggle_drc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_selector"
                    android:focusable="true"
                    android:text="DRC Limiter: ON"
                    android:textColor="@drawable/btn_text_color"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_toggle_surround"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_selector"
                    android:focusable="true"
                    android:text="Surround Sound: OFF"
                    android:textColor="@drawable/btn_text_color"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_apply_custom"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_selector"
                android:focusable="true"
                android:text="Save &amp; Apply Custom Profile"
                android:textColor="@drawable/btn_text_color"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
